{
  "manifest_version": 3,
  "name": "Link Safety Analyzer",
  "version": "1.0",
  "description": "Analyze copied links using VirusTotal API.",
  "permissions": [
    "clipboardRead",
    "storage",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}
