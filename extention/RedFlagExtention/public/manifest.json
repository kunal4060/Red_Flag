{
  "manifest_version": 3,
  "name": "RedFlag Extension",
  "version": "1.0.0",
  "description": "Analyze copied links with AI",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.virustotal.com/*",
    "http://localhost/*"
  ]
}