{
  "manifest_version": 3,
  "name": "RedFlag Extension",
  "version": "1.0.0",
  "description": "Analyze copied links with VirusTotal",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://www.virustotal.com/*",
    "http://localhost:5001/*"
  ]
}